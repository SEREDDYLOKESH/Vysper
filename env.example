# Google Gemini API Configuration
# Get your API key from: https://aistudio.google.com/app/apikey
# Configure multiple keys for automatic quota failover (429 / RESOURCE_EXHAUSTED rotation)
GEMINI_API_KEY_1=your_primary_key_here
GEMINI_API_KEY_2=your_backup_key_here
GEMINI_API_KEY_3=your_third_key_here

# Primary Gemini model (multi-key failover supported)
GEMINI_MODEL=gemini-2.5-flash

# Azure Speech Services Configuration (optional/legacy)
AZURE_SPEECH_KEY=your_azure_speech_key_here
AZURE_SPEECH_REGION=your_azure_region_here

